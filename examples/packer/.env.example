# ============================================================================================= #
# .env.example — Environment variables for AWS authentication                                  #
#                                                                                               #
# Copy this file to .env and update the values for your environment.                            #
# These variables are consumed by Packer (PKR_VAR_*) and the AWS SDK credential chain.          #
# The framework never accepts static access keys as Packer variables; authenticate through     #
# the ambient credential chain (SSO/OIDC/instance profile) or a shared-credentials profile.    #
# ============================================================================================= #

# --- AWS Settings ---------------------------------------------------------------------------- #
PKR_VAR_aws_region="us-east-1"
PKR_VAR_aws_profile="packer-build"

# Ambient credential chain examples (pick one mechanism; do not commit real values):
# AWS_PROFILE="packer-build"
# AWS_ROLE_ARN="arn:aws:iam::000000000000:role/aws-packer-framework-build"
# AWS_WEB_IDENTITY_TOKEN_FILE="/run/secrets/oidc-token"

# --- Deploy User ----------------------------------------------------------------------------- #
PKR_VAR_deploy_user_name="ec2-user"
